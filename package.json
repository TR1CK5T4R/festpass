{
  "name": "festpass",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "format": "prettier --write .",
    "infra:up": "docker compose --project-directory . -f infra/docker-compose.yml up -d --wait",
    "infra:down": "docker compose --project-directory . -f infra/docker-compose.yml down",
    "db:migrate": "pnpm --filter @festpass/db exec prisma migrate dev",
    "db:reset": "pnpm --filter @festpass/db exec prisma migrate reset --force",
    "db:seed": "pnpm --filter @festpass/db exec prisma db seed",
    "demo:analytics": "pnpm --filter @festpass/api demo:analytics",
    "db:studio": "pnpm --filter @festpass/db exec prisma studio",
    "perf:seed": "pnpm --filter @festpass/db perf:seed",
    "perf:explain": "pnpm --filter @festpass/db perf:explain",
    "perf:explain-mongo": "pnpm --filter @festpass/api perf:explain-mongo",
    "loadtest:api": "pnpm --filter \"@festpass/api...\" build && pnpm --filter @festpass/api loadtest:api",
    "loadtest:setup": "pnpm --filter @festpass/api loadtest:setup",
    "loadtest:flash": "docker run --rm -v \"$PWD/infra/k6:/k6\" -e API_URL -e RATE grafana/k6:2.3.0 run --quiet /k6/flash-sale.js",
    "loadtest:browse": "docker run --rm -v \"$PWD/infra/k6:/k6\" -e API_URL -e RATE grafana/k6:2.3.0 run --quiet /k6/browse.js",
    "loadtest:verify": "pnpm --filter @festpass/db loadtest:verify",
    "storage:init": "pnpm --filter @festpass/api storage:init",
    "storage:upload-banner": "pnpm --filter @festpass/api storage:upload-banner",
    "webhook:simulate": "pnpm --filter @festpass/api webhook:simulate",
    "keys:generate": "pnpm --filter @festpass/api keys:generate"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
