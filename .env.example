# Copy to .env: cp .env.example .env
# Local development values only. Never put real secrets in this file.

# --- Apps ---
API_PORT=4000
# development shows error details and stacks in API responses; test and production never do.
NODE_ENV=development
# pino log level: fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info
# The web app runs on 3000 (set in apps/web/package.json).
# Origins allowed to call the API with cookies (CORS), comma-separated.
WEB_ORIGINS=http://localhost:3000
# Where the browser sends API requests. Inlined into the web bundle at build time, so never put secrets in NEXT_PUBLIC_ vars.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# --- Auth ---
# Signs access tokens (JWT, HS256). At least 32 characters; generate a real one with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-change-me-0123456789abcdefghijklmnop
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# --- PostgreSQL 16 ---
POSTGRES_PORT=5433
DATABASE_URL=postgresql://festpass:festpass@localhost:5433/festpass
# Separate database for automated tests; they truncate tables, so never point this at real data.
DATABASE_URL_TEST=postgresql://festpass:festpass@localhost:5433/festpass_test

# --- MongoDB 7 ---
MONGO_PORT=27018
MONGODB_URI=mongodb://localhost:27018/festpass

# --- Redis 7 ---
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# --- MinIO (S3-compatible storage) ---
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=festpass
MINIO_ROOT_PASSWORD=festpass-dev-secret
S3_ENDPOINT=http://localhost:9000
