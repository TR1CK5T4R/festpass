# Copy to .env: cp .env.example .env
# Local development values only. Never put real secrets in this file.

# --- Apps ---
API_PORT=4000
# development shows error details and stacks in API responses; test and production never do.
NODE_ENV=development
# pino log level: fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info
# The web app runs on 3000 (set in apps/web/package.json).
# Origins allowed to call the API with cookies (CORS), comma-separated.
WEB_ORIGINS=http://localhost:3000
# Where the browser sends API requests. Inlined into the web bundle at build time, so never put secrets in NEXT_PUBLIC_ vars.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# How long a booking holds its tickets before they go back on sale if unpaid (minutes, up to 60, default 10).
# Redis booking gate: on (default) or off, to compare the two in load tests. Correct either way.
BOOKING_GATE=on
HOLD_MINUTES=10
# Rate limits (token bucket) as <burst>/<per minute>: login per IP + email, register per IP,
# orders and presign per user.
RATE_LIMIT_LOGIN=5/5
RATE_LIMIT_REGISTER=20/10
RATE_LIMIT_ORDERS=10/30
RATE_LIMIT_PRESIGN=10/10
RATE_LIMIT_QUEUE_JOIN=10/30
# Razorpay TEST keys (Dashboard > Account & Settings > API keys, in Test Mode). Live keys are refused.
# Leave both empty to run without payments: POST /orders/:id/pay then answers 503.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Any long random string you choose (openssl rand -hex 32); paste the same value into Razorpay's
# webhook settings. Also signs `pnpm webhook:simulate`, so it is useful without a Razorpay account.
RAZORPAY_WEBHOOK_SECRET=
# Ticket QR keys (Ed25519). Generate with `pnpm keys:generate` and paste both lines here.
# The private key signs QR codes (API and worker only); the public key verifies them (web scanner).
TICKET_SIGNING_PRIVATE_KEY=
NEXT_PUBLIC_TICKET_PUBLIC_KEY=
# Email (worker). console: nothing is sent; each email is logged and saved as HTML in .email-previews/.
# sendgrid: needs the API key and the three dynamic template IDs (README "Email setup").
EMAIL_PROVIDER=console
EMAIL_FROM=FestPass <tickets@festpass.dev>
SENDGRID_API_KEY=
SENDGRID_TEMPLATE_TICKET_CONFIRMATION=
SENDGRID_TEMPLATE_ORDER_EXPIRED=
SENDGRID_TEMPLATE_REFUND_ISSUED=
SENDGRID_TEMPLATE_SPONSOR_REPORT=
# Links inside emails point here.
PUBLIC_WEB_URL=http://localhost:3000
# Who may open the job dashboard (Bull Board) at http://localhost:4000/admin/queues, comma-separated.
ADMIN_EMAILS=organizer@festpass.dev
# The API calls this web route when a public event changes, so its cached page is rebuilt.
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
# Shared by API and web; at least 32 characters. Generate a real one with: openssl rand -base64 48
REVALIDATE_SECRET=dev-only-change-me-revalidate-0123456789abcdef

# --- Auth ---
# Signs access tokens (JWT, HS256). At least 32 characters; generate a real one with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-change-me-0123456789abcdefghijklmnop
# Signs waiting-room admission tokens; set in the API and the worker, and different from JWT_ACCESS_SECRET.
ADMISSION_TOKEN_SECRET=dev-only-change-me-admission-0123456789abcdef
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# --- PostgreSQL 16 ---
POSTGRES_PORT=5433
DATABASE_URL=postgresql://festpass:festpass@localhost:5433/festpass
# Separate database for automated tests; they truncate tables, so never point this at real data.
DATABASE_URL_TEST=postgresql://festpass:festpass@localhost:5433/festpass_test

# --- MongoDB 7 ---
MONGO_PORT=27018
MONGODB_URI=mongodb://localhost:27018/festpass

# --- Redis 7 ---
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# --- S3-compatible storage (SeaweedFS locally, Cloudflare R2 in production) ---
S3_PORT=9000
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=festpass
S3_ACCESS_KEY_ID=festpass
S3_SECRET_ACCESS_KEY=festpass-dev-secret
# Where public objects (banners) are read from: the bucket URL locally, the R2 public domain in production.
S3_PUBLIC_URL=http://localhost:9000/festpass
