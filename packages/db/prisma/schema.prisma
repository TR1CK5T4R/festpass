// FestPass schema v1. Tables and columns are snake_case so the raw SQL booking path reads naturally.
// CHECK constraints live in prisma/migrations/*_check_constraints because Prisma can't express them.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum OrgRole {
  OWNER
  MANAGER
  SCANNER

  @@map("org_role")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CLOSED

  @@map("event_status")
}

enum OrderStatus {
  PENDING
  PAID
  TICKETED
  EXPIRED
  CANCELLED
  REFUNDED

  @@map("order_status")
}

enum SponsorTier {
  TITLE
  GOLD
  SILVER

  @@map("sponsor_tier")
}

model User {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String   @unique
  passwordHash   String   @map("password_hash")
  name           String
  college        String?
  branch         String?
  graduationYear Int?     @map("graduation_year")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  refreshTokens     RefreshToken[]
  memberships       OrgMember[]
  orders            Order[]
  tickets           Ticket[]        @relation("TicketOwner")
  checkedInTickets  Ticket[]        @relation("TicketCheckedInBy")
  sponsorMembership SponsorMember[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  // All tokens from one login share a family, so reuse of an old token can revoke the whole chain.
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}

model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  members OrgMember[]
  events  Event[]

  @@map("organizations")
}

model OrgMember {
  orgId     String   @map("org_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      OrgRole
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([orgId, userId])
  @@index([userId])
  @@map("org_members")
}

model Event {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String      @map("org_id") @db.Uuid
  title           String
  slug            String      @unique
  description     String
  venue           String
  startsAt        DateTime    @map("starts_at") @db.Timestamptz
  endsAt          DateTime    @map("ends_at") @db.Timestamptz
  saleStartsAt    DateTime    @map("sale_starts_at") @db.Timestamptz
  saleEndsAt      DateTime    @map("sale_ends_at") @db.Timestamptz
  status          EventStatus @default(DRAFT)
  bannerKey       String?     @map("banner_key")
  queueMode       Boolean     @default(false) @map("queue_mode")
  admitRatePerSec Int         @default(50) @map("admit_rate_per_sec")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  org      Organization @relation(fields: [orgId], references: [id])
  tiers    TicketTier[]
  orders   Order[]
  sponsors Sponsor[]

  @@index([orgId, status])
  // Public listing: WHERE status = 'PUBLISHED' ORDER BY starts_at, id, paged with a (starts_at, id) cursor.
  @@index([status, startsAt, id])
  @@map("events")
}

model TicketTier {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId      String    @map("event_id") @db.Uuid
  name         String
  pricePaise   Int       @map("price_paise")
  capacity     Int
  soldCount    Int       @default(0) @map("sold_count")
  perUserLimit Int       @default(4) @map("per_user_limit")
  // Optional per-tier window (e.g. early bird); null means the event's sale window applies.
  saleStartsAt DateTime? @map("sale_starts_at") @db.Timestamptz
  saleEndsAt   DateTime? @map("sale_ends_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  tickets    Ticket[]

  @@unique([eventId, name])
  @@map("ticket_tiers")
}

// An order is a purchase (money, hold expiry). A ticket is an entry right. They have different lifecycles.
model Order {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String      @map("user_id") @db.Uuid
  eventId         String      @map("event_id") @db.Uuid
  status          OrderStatus @default(PENDING)
  amountPaise     Int         @map("amount_paise")
  expiresAt       DateTime    @map("expires_at") @db.Timestamptz
  razorpayOrderId String?     @unique @map("razorpay_order_id")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user     User        @relation(fields: [userId], references: [id])
  event    Event       @relation(fields: [eventId], references: [id])
  items    OrderItem[]
  payments Payment[]
  tickets  Ticket[]

  @@index([userId, status])
  // The hold-expiry sweep looks for PENDING orders whose expires_at has passed.
  @@index([status, expiresAt])
  @@map("orders")
}

model OrderItem {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId        String @map("order_id") @db.Uuid
  tierId         String @map("tier_id") @db.Uuid
  qty            Int
  // Copied at booking time so a later price change never rewrites what someone paid.
  unitPricePaise Int    @map("unit_price_paise")

  order Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tier  TicketTier @relation(fields: [tierId], references: [id])

  @@unique([orderId, tierId])
  @@map("order_items")
}

model Payment {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId           String   @map("order_id") @db.Uuid
  // Unique so a webhook delivered twice can only insert one payment row.
  razorpayPaymentId String   @unique @map("razorpay_payment_id")
  // Free text: mirrors Razorpay's own payment states (created, authorized, captured, failed, refunded).
  status            String
  rawPayload        Json     @map("raw_payload") @db.JsonB
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("payments")
}

model Ticket {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String    @map("order_id") @db.Uuid
  tierId      String    @map("tier_id") @db.Uuid
  ownerUserId String    @map("owner_user_id") @db.Uuid
  // 1..qty within the order; unique(order_id, seq) makes ticket issuing safe to retry.
  seq         Int
  code        String    @unique
  // Bumped to invalidate old QR codes (e.g. on transfer).
  qrVersion   Int       @default(1) @map("qr_version")
  checkedInAt DateTime? @map("checked_in_at") @db.Timestamptz
  checkedInBy String?   @map("checked_in_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  order         Order      @relation(fields: [orderId], references: [id])
  tier          TicketTier @relation(fields: [tierId], references: [id])
  owner         User       @relation("TicketOwner", fields: [ownerUserId], references: [id])
  checkedInUser User?      @relation("TicketCheckedInBy", fields: [checkedInBy], references: [id])

  // No separate tickets(order_id) index: this unique index starts with order_id, so it already serves those lookups.
  @@unique([orderId, seq])
  @@index([ownerUserId])
  @@map("tickets")
}

model Sponsor {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId   String      @map("event_id") @db.Uuid
  name      String
  tier      SponsorTier
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz

  event   Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  members SponsorMember[]
  booths  Booth[]

  @@unique([eventId, name])
  @@map("sponsors")
}

model SponsorMember {
  sponsorId String @map("sponsor_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid

  sponsor Sponsor @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sponsorId, userId])
  @@index([userId])
  @@map("sponsor_members")
}

model Booth {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sponsorId String @map("sponsor_id") @db.Uuid
  name      String

  sponsor Sponsor @relation(fields: [sponsorId], references: [id], onDelete: Cascade)

  @@unique([sponsorId, name])
  @@map("booths")
}
