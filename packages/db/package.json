{
  "name": "@festpass/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "development": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./booking": {
      "development": "./src/booking.ts",
      "types": "./dist/booking.d.ts",
      "default": "./dist/booking.js"
    },
    "./inventory": {
      "development": "./src/inventory.ts",
      "types": "./dist/inventory.d.ts",
      "default": "./dist/inventory.js"
    },
    "./order-state": {
      "development": "./src/order-state.ts",
      "types": "./dist/order-state.d.ts",
      "default": "./dist/order-state.js"
    },
    "./payments": {
      "development": "./src/payments.ts",
      "types": "./dist/payments.d.ts",
      "default": "./dist/payments.js"
    },
    "./tickets": {
      "development": "./src/tickets.ts",
      "types": "./dist/tickets.d.ts",
      "default": "./dist/tickets.js"
    },
    "./emails": {
      "development": "./src/emails.ts",
      "types": "./dist/emails.d.ts",
      "default": "./dist/emails.js"
    }
  },
  "scripts": {
    "postinstall": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "perf:seed": "tsx scripts/seed-bulk.ts",
    "perf:explain": "tsx scripts/explain-hot.ts"
  },
  "dependencies": {
    "@festpass/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcrypt": "^6.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
