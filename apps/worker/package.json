{
  "name": "@festpass/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@festpass/db": "workspace:*",
    "@festpass/shared": "workspace:*",
    "bullmq": "^6.5.4",
    "ioredis": "^6.0.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  }
}
